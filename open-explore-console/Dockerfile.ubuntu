# 使用Ubuntu基础镜像 + OpenJDK 8
FROM ubuntu:20.04

# 避免交互式安装
ENV DEBIAN_FRONTEND=noninteractive

# 安装OpenJDK 8和Maven
RUN apt-get update && \
    apt-get install -y openjdk-8-jdk maven && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# 设置JAVA_HOME
ENV JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64

# 设置工作目录
WORKDIR /app

# 复制pom.xml和源代码
COPY pom.xml .
COPY src src

# 构建应用
RUN mvn clean package -DskipTests

# 暴露端口
EXPOSE 8088

# 运行应用
CMD ["java", "-jar", "target/article-0.0.1-open-explore-console.jar"]